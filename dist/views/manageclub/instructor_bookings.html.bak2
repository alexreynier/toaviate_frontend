<div class="centre_align_boxes2">


      <div class="home_upper">
        <div class="back-box" ui-sref="dashboard.manage_club">
              <i class="fa fa-arrow-circle-left"></i> BACK
            </div>
          <div class="welcome_title"> 
            <h2>BOOKING SETTINGS</h2> 
            <h4 class="capitalise">
              Manage your booking page & instructors
            </h4>
          </div>
      </div>


      <div class="club_docs bookingout_wrapper">
            
          

           <div class="plane_docs">

        <h4>Manage Instructors</h4>

            <div class="card" ng-if="vm.club.instructors.length > 0">
                <table>
                    <tr>
                        <th>Name</th>
                        <th>Courses</th>
                        <th>Notes</th>
                        <th>Colours</th>
                        <th>Functions</th>
                    </tr>
                    <tbody dnd-list="vm.club.instructors">
                         <tr ng-repeat="instructor in vm.club.instructors" dnd-draggable="instructor" dnd-moved="vm.club.instructors.splice($index, 1);save_instructor_order()">
                            <td uib-tooltip="{{ instructor.email }}" tooltip-append-to-body="true">{{ instructor.first_name }} {{ instructor.last_name }}</td>
                            <td> Courses </td>
                            <td>{{ instructor.instructor_notes }}</td>
                            <td>
                                instructor_colour: <span ng-if="!instructor.edit"><span class="coloured_square" style="background: {{ instructor.instructor_colour }}"> &nbsp;</span></span> <span ng-if="instructor.edit"><input type="color" ng-model="instructor.new_colour" /> </span> <br />
                                booking_colour:
                                 <span ng-if="!instructor.edit"><span class="coloured_square" style="background: {{ instructor.booking_colour }}"> &nbsp;</span></span>
                                <span ng-if="instructor.edit"><input type="color" ng-model="instructor.new_booking_colour" /> </span>
                            </td>
                            <td>
                                <a ng-if="!instructor.edit" ng-click="instructor.edit = true;" uib-tooltip="Manage"><i class="fa fa-edit list_icons"></i></a> &nbsp; 

                                <a ng-if="instructor.edit" ng-click="vm.save_instructor(instructor)" uib-tooltip="Save"><i class="fa fa-save list_icons green"></i></a>
                                <!-- <a ng-click="open(plane.id)" uib-tooltip="Delete"><i class="fa fa-trash-alt list_icons"></i></a> -->
                            </td>
                        </tr>
                        <tr class="dndPlaceholder background_content_dnd">
                            <td colspan="5">
                              Drop Here
                            </td>
                          </tr>
                    </tbody>

                </table>

            </div>

        </div>


        <!-- ═══════════════════════════════════════════════════════════
             INSTRUCTOR EMAIL PREFERENCES
             ═══════════════════════════════════════════════════════════ -->
        <div class="plane_docs" ng-if="vm.club.instructors.length > 0">

          <h4>Email Preferences</h4>

          <!-- Desktop table -->
          <div class="ep-table-wrap">
            <div class="card">
              <table>
                <thead>
                  <tr>
                    <th>Instructor</th>
                    <th>Booking Notifications</th>
                    <th>Booking Reminders</th>
                    <th>Daily Schedule Summary</th>
                  </tr>
                </thead>
                <tbody>
                  <tr ng-repeat="instructor in vm.club.instructors">
                    <td class="ep-name">{{ instructor.first_name }} {{ instructor.last_name }}</td>
                    <td>
                      <toggle-switch
                        on-label="On" off-label="Off"
                        ng-model="instructor._receiveNotifications"
                        ng-change="vm.save_email_prefs(instructor)">
                      </toggle-switch>
                    </td>
                    <td>
                      <toggle-switch
                        on-label="On" off-label="Off"
                        ng-model="instructor._receiveReminders"
                        ng-change="vm.save_email_prefs(instructor)">
                      </toggle-switch>
                    </td>
                    <td>
                      <toggle-switch
                        on-label="On" off-label="Off"
                        ng-model="instructor._receiveDailySummary"
                        ng-change="vm.save_email_prefs(instructor)">
                      </toggle-switch>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Mobile cards -->
          <div class="ep-cards">
            <div class="ep-card" ng-repeat="instructor in vm.club.instructors">
              <div class="ep-card-header">
                <i class="fa fa-user-tie"></i>
                <span>{{ instructor.first_name }} {{ instructor.last_name }}</span>
              </div>
              <div class="ep-card-body">

                <div class="ep-row">
                  <div class="ep-row-info">
                    <span class="ep-row-label">Booking Notifications</span>
                    <span class="ep-row-desc">Email each time a student books a lesson</span>
                  </div>
                  <toggle-switch
                    on-label="On" off-label="Off"
                    ng-model="instructor._receiveNotifications"
                    ng-change="vm.save_email_prefs(instructor)">
                  </toggle-switch>
                </div>

                <div class="ep-row">
                  <div class="ep-row-info">
                    <span class="ep-row-label">Booking Reminders</span>
                    <span class="ep-row-desc">Reminder the evening before each booking</span>
                  </div>
                  <toggle-switch
                    on-label="On" off-label="Off"
                    ng-model="instructor._receiveReminders"
                    ng-change="vm.save_email_prefs(instructor)">
                  </toggle-switch>
                </div>

                <div class="ep-row">
                  <div class="ep-row-info">
                    <span class="ep-row-label">Daily Schedule Summary</span>
                    <span class="ep-row-desc">Combined email listing all bookings for tomorrow</span>
                  </div>
                  <toggle-switch
                    on-label="On" off-label="Off"
                    ng-model="instructor._receiveDailySummary"
                    ng-change="vm.save_email_prefs(instructor)">
                  </toggle-switch>
                </div>

              </div>
            </div>
          </div>

        </div>

</div>



        </div>
</div>